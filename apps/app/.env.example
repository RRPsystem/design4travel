# Supabase — frontend-safe keys only
# Get these from Supabase dashboard → Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_...) or the legacy ANON public key (eyJ...).
# NEVER use the secret key (sb_secret_...) or a service_role JWT here — those bypass RLS
# and any VITE_-prefixed value is baked into the public JS bundle at build time.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
